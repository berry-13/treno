/**
 * ViaggiaTreno / RFI provider (GOAL.md §6). Undocumented REST API, widely
 * reverse engineered. Two-step resolution: autocomplete maps a train number to
 * (number, originStationCode, departureEpochMs); andamentoTreno returns the
 * full running state. Reporting points (e.g. Bivio Casirate) appear in the
 * last-detection fields, not necessarily in fermate.
 */
import { createHash } from 'node:crypto';
import { romeYmd } from '#core/time.ts';
import { politeFetch, type FetchResult } from './http.ts';
import type { ProviderStopEvent, ProviderTrainSnapshot } from './types.ts';

export const VT_SOURCE = 'viaggiatreno';
export const VT_BASE = 'http://www.viaggiatreno.it/infomobilita/resteasy/viaggiatreno';
export const VT_PARSER_VERSION = 'vt-v1';

function str(v: unknown): string | null {
  return typeof v === 'string' && v.length > 0 ? v : null;
}
function num(v: unknown): number | null {
  if (typeof v === 'number' && Number.isFinite(v)) return v;
  if (typeof v === 'string' && v.trim() !== '' && Number.isFinite(Number(v))) return Number(v);
  return null;
}
function epoch(v: unknown): number | null {
  const n = num(v);
  // ViaggiaTreno epochs are ms; guard against seconds-scale values
  if (n == null || n <= 0) return null;
  return n > 1e12 ? n : n > 1e9 ? n * 1000 : null;
}

export interface VtTrainRef {
  trainNumber: string;
  originCode: string;
  departureEpochMs: number;
  label: string | null;
}

/** Resolve which concrete run(s) a train number refers to (today). */
export async function vtAutocomplete(trainNumber: string, userAgent: string): Promise<{ refs: VtTrainRef[]; result: FetchResult }> {
  const url = VT_BASE + '/cercaNumeroTrenoTrenoAutocomplete/' + encodeURIComponent(trainNumber);
  const result = await politeFetch(url, { source: VT_SOURCE, userAgent });
  const refs: VtTrainRef[] = [];
  if (result.ok) {
    for (const line of result.text.split('\n')) {
      const trimmed = line.trim();
      if (trimmed === '') continue;
      const bar = trimmed.indexOf('|');
      if (bar < 0) continue;
      const key = trimmed.slice(bar + 1);
      const segs = key.split('-');
      if (segs.length < 3) continue;
      const depMs = epoch(segs[segs.length - 1]);
      const origin = segs[segs.length - 2]!;
      const number = segs.slice(0, segs.length - 2).join('-');
      if (depMs == null || origin === '' || number === '') continue;
      refs.push({ trainNumber: number, originCode: origin, departureEpochMs: depMs, label: trimmed.slice(0, bar) });
    }
  }
  return { refs, result };
}

export function vtSourceKey(ref: VtTrainRef): string {
  return ref.trainNumber + '|' + ref.originCode + '|' + String(ref.departureEpochMs);
}

export function parseVtTrain(raw: string, ref: VtTrainRef): ProviderTrainSnapshot | null {
  let json: unknown;
  try {
    json = JSON.parse(raw);
  } catch {
    return null;
  }
  if (json == null || typeof json !== 'object') return null;
  const t = json as Record<string, unknown>;
  const fermate = Array.isArray(t.fermate) ? (t.fermate as Array<Record<string, unknown>>) : [];
  const serviceDate = romeYmd(ref.departureEpochMs);
  const topDelayMin = num(t.ritardo);

  const stops: ProviderStopEvent[] = [];
  fermate.forEach((f) => {
    const partTeor = epoch(f.partenza_teorica);
    const arrTeor = epoch(f.arrivo_teorico);
    const programmata = epoch(f.programmata);
    const partReale = epoch(f.partenzaReale);
    const arrReale = epoch(f.arrivoReale);
    const ritPartMin = num(f.ritardoPartenza);
    const ritArrMin = num(f.ritardoArrivo);
    const delaySec = topDelayMin != null ? Math.round(topDelayMin * 60) : null;
    // operator prediction for not-yet-happened events: theoretical + current delay
    const opPredDep = partReale ?? (partTeor != null && delaySec != null ? partTeor + delaySec * 1000 : null);
    const opPredArr = arrReale ?? (arrTeor != null && delaySec != null ? arrTeor + delaySec * 1000 : null);
    const platformActual = str(f.binarioEffettivoPartenzaCodice) ?? str(f.binarioEffettivoArrivoCodice);
    const platformSched = str(f.binarioProgrammatoPartenzaCodice) ?? str(f.binarioProgrammatoArrivoCodice);
    const seq = num(f.progressivo);
    stops.push({
      stopId: str(f.id),
      stopName: str(f.stazione),
      stopSequence: seq != null ? Math.round(seq) : null,
      schedArrEpoch: arrTeor ?? programmata,
      schedDepEpoch: partTeor ?? programmata,
      opPredArrEpoch: opPredArr,
      opPredDepEpoch: opPredDep,
      actualArrEpoch: arrReale,
      actualDepEpoch: partReale,
      arrDelaySec: ritArrMin != null ? Math.round(ritArrMin * 60) : null,
      depDelaySec: ritPartMin != null ? Math.round(ritPartMin * 60) : null,
      platform: platformActual ?? platformSched,
      platformIsActual: platformActual != null,
      cancelled: null,
    });
  });

  const first = stops[0];
  const last = stops[stops.length - 1];
  const midnight = serviceDate + 'T00:00:00';
  void midnight;
  return {
    source: VT_SOURCE,
    sourceKey: vtSourceKey(ref),
    serviceDate,
    trainNumber: ref.trainNumber,
    operator: 'RFI',
    originStopId: str(t.codLocOrig) ?? first?.stopId ?? ref.originCode,
    destinationStopId: last?.stopId ?? null,
    originStopName: first?.stopName ?? null,
    destinationStopName: last?.stopName ?? null,
    schedDepSec: first?.schedDepEpoch != null ? Math.round((first.schedDepEpoch - ref.departureEpochMs) / 1000) + secondsSinceMidnightLocal(ref.departureEpochMs) : null,
    schedArrSec: null,
    delaySeconds: topDelayMin != null ? Math.round(topDelayMin * 60) : null,
    status: str(t.tipoTreno),
    hasLiveInfo: t.oraUltimoRilevamento != null,
    lastLocationId: str(t.idStazioneUltimoRilevamento),
    lastLocationName: str(t.stazioneUltimoRilevamento),
    observedAt: epoch(t.oraUltimoRilevamento),
    cancelled: Array.isArray(t.fermateSoppresse) && t.fermateSoppresse.length > 0 ? true : null,
    crowding: null,
    alerts: Array.isArray(t.compRitardo) ? t.compRitardo : [],
    stops,
  };
}

function secondsSinceMidnightLocal(epochMs: number): number {
  const d = new Date(epochMs);
  return d.getUTCHours() * 3600 + d.getUTCMinutes() * 60 + d.getUTCSeconds();
}

export function vtRelevantHash(s: ProviderTrainSnapshot): string {
  const rel = {
    d: s.delaySeconds, st: s.status, loc: s.lastLocationId, obs: s.observedAt,
    stops: s.stops.map((x) => [x.stopId, x.opPredArrEpoch, x.opPredDepEpoch, x.actualArrEpoch, x.actualDepEpoch, x.platform]),
  };
  return createHash('sha256').update(JSON.stringify(rel)).digest('hex');
}

export interface VtFetch {
  raw: string;
  result: FetchResult;
  snapshot: ProviderTrainSnapshot | null;
  relevantHash: string;
}

export async function fetchVtTrain(ref: VtTrainRef, userAgent: string): Promise<VtFetch> {
  const url = VT_BASE + '/andamentoTreno/' + encodeURIComponent(ref.originCode) + '/' + encodeURIComponent(ref.trainNumber) + '/' + String(ref.departureEpochMs);
  const result = await politeFetch(url, { source: VT_SOURCE, userAgent });
  const snapshot = result.ok ? parseVtTrain(result.text, ref) : null;
  const relevantHash = snapshot ? vtRelevantHash(snapshot) : '';
  return { raw: result.text, result, snapshot, relevantHash };
}
