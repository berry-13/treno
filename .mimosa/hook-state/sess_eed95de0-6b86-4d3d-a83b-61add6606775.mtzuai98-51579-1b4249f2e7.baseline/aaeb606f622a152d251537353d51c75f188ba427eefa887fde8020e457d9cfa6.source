/**
 * Loads the canonical Trenord GTFS ZIP (GOAL.md §8) into the SQLite schedule
 * store. Times are kept as seconds since service-day midnight (may exceed
 * 86400) — never converted to wall times.
 *
 * SQL discipline: db.exec() receives only inline string literals (DDL); all
 * DML row data flows through prepared-statement bound parameters (runStmt).
 */
import { createHash } from 'node:crypto';
import { unzipSync, strFromU8 } from 'fflate';
import { getRow, getRows, runStmt, type Db } from '#core/db.ts';
import { log } from '#core/log.ts';
import { table } from './csv.ts';

export interface LoadResult {
  sha256: string;
  counts: Record<string, number>;
  feedStart: string | null;
  feedEnd: string | null;
}

interface Validity { tripId: string; from: string | null; to: string | null }

/** trip/service ids look like "{trainNumber}-{validFrom}-{validTo}" in this feed. */
function parseValidity(serviceId: string): { from: string | null; to: string | null } {
  const parts = serviceId.split('-');
  if (parts.length >= 3) {
    const to = parts[parts.length - 1]!;
    const from = parts[parts.length - 2]!;
    if (/^\d{4}-\d{2}-\d{2}$/.test(from) && /^\d{4}-\d{2}-\d{2}$/.test(to)) return { from, to };
  }
  return { from: null, to: null };
}

function hmsToSec(v: string | undefined): number | null {
  if (!v) return null;
  const parts = v.split(':');
  if (parts.length < 2) return null;
  const h = Number(parts[0]); const m = Number(parts[1]); const s = parts.length > 2 ? Number(parts[2]) : 0;
  if (!Number.isFinite(h) || !Number.isFinite(m)) return null;
  return h * 3600 + m * 60 + (Number.isFinite(s) ? s : 0);
}

function gtfsDateToIso(d: string): string | null {
  if (/^\d{8}$/.test(d)) return d.slice(0, 4) + '-' + d.slice(4, 6) + '-' + d.slice(6, 8);
  return null;
}

export function ensureGtfsTables(db: Db): void {
  db.exec(`CREATE TABLE IF NOT EXISTS gtfs_feed_versions(
  id INTEGER PRIMARY KEY, sha256 TEXT NOT NULL, loaded_at INTEGER NOT NULL,
  counts_json TEXT, feed_start TEXT, feed_end TEXT)`);
  db.exec(`CREATE TABLE IF NOT EXISTS gtfs_stops(
  stop_id TEXT PRIMARY KEY, stop_name TEXT, stop_lat REAL, stop_lon REAL, stop_url TEXT)`);
  db.exec(`CREATE TABLE IF NOT EXISTS gtfs_routes(
  route_id TEXT PRIMARY KEY, agency_id TEXT, route_short_name TEXT, route_long_name TEXT, route_type INTEGER)`);
  db.exec(`CREATE TABLE IF NOT EXISTS gtfs_trips(
  trip_id TEXT PRIMARY KEY, route_id TEXT, service_id TEXT, trip_short_name TEXT)`);
  db.exec('CREATE INDEX IF NOT EXISTS idx_gtfs_trips_shortname ON gtfs_trips(trip_short_name)');
  db.exec(`CREATE TABLE IF NOT EXISTS gtfs_stop_times(
  trip_id TEXT NOT NULL, stop_sequence INTEGER NOT NULL, stop_id TEXT NOT NULL,
  arrival_sec INTEGER, departure_sec INTEGER,
  PRIMARY KEY(trip_id, stop_sequence)) WITHOUT ROWID`);
  db.exec('CREATE INDEX IF NOT EXISTS idx_gtfs_st_times_stop ON gtfs_stop_times(stop_id, departure_sec)');
  db.exec(`CREATE TABLE IF NOT EXISTS gtfs_calendar_dates(
  service_id TEXT NOT NULL, date TEXT NOT NULL, exception_type INTEGER,
  PRIMARY KEY(service_id, date)) WITHOUT ROWID`);
  db.exec('CREATE INDEX IF NOT EXISTS idx_gtfs_cal_date ON gtfs_calendar_dates(date)');
  db.exec(`CREATE TABLE IF NOT EXISTS gtfs_trip_summaries(
  trip_id TEXT PRIMARY KEY, route_id TEXT, train_number TEXT,
  origin_stop_id TEXT, destination_stop_id TEXT,
  origin_seq INTEGER, destination_seq INTEGER, stop_count INTEGER,
  dep_sec INTEGER, arr_sec INTEGER, valid_from TEXT, valid_to TEXT)`);
  db.exec('CREATE INDEX IF NOT EXISTS idx_summ_num ON gtfs_trip_summaries(train_number)');
}

function clearGtfsTables(db: Db): void {
  db.exec('DELETE FROM gtfs_feed_versions');
  db.exec('DELETE FROM gtfs_stops');
  db.exec('DELETE FROM gtfs_routes');
  db.exec('DELETE FROM gtfs_trips');
  db.exec('DELETE FROM gtfs_stop_times');
  db.exec('DELETE FROM gtfs_calendar_dates');
  db.exec('DELETE FROM gtfs_trip_summaries');
}

interface TripRow { trip_id: string; route_id: string | null; trip_short_name: string | null; service_id: string | null }
interface StopRow { stop_id: string; departure_sec: number | null; arrival_sec: number | null }

function buildTripSummaries(db: Db, validities: Map<string, Validity>): void {
  const trips = getRows<TripRow>(db, 'SELECT trip_id, route_id, trip_short_name, service_id FROM gtfs_trips');
  const ins = db.prepare('INSERT OR REPLACE INTO gtfs_trip_summaries(trip_id, route_id, train_number, origin_stop_id, destination_stop_id, origin_seq, destination_seq, stop_count, dep_sec, arr_sec, valid_from, valid_to) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)');
  for (const t of trips) {
    const first = getRow<StopRow & { stop_sequence: number }>(db, 'SELECT stop_id, departure_sec, arrival_sec, stop_sequence FROM gtfs_stop_times WHERE trip_id=? ORDER BY stop_sequence ASC LIMIT 1', [t.trip_id]);
    const last = getRow<StopRow & { stop_sequence: number }>(db, 'SELECT stop_id, departure_sec, arrival_sec, stop_sequence FROM gtfs_stop_times WHERE trip_id=? ORDER BY stop_sequence DESC LIMIT 1', [t.trip_id]);
    const cnt = getRow<{ c: number }>(db, 'SELECT COUNT(*) AS c FROM gtfs_stop_times WHERE trip_id=?', [t.trip_id]);
    const v = t.service_id ? validities.get(t.trip_id) : undefined;
    runStmt(ins, [
      t.trip_id, t.route_id, t.trip_short_name,
      first?.stop_id ?? null, last?.stop_id ?? null,
      first?.stop_sequence ?? null, last?.stop_sequence ?? null, cnt?.c ?? 0,
      first?.departure_sec ?? null, last?.arrival_sec ?? null,
      v?.from ?? null, v?.to ?? null,
    ]);
  }
}

export function loadGtfsZip(db: Db, zipBytes: Uint8Array): LoadResult {
  const sha256 = createHash('sha256').update(zipBytes).digest('hex');
  ensureGtfsTables(db);
  const prev = getRow<{ sha256: string; counts_json: string; feed_start: string | null; feed_end: string | null }>(
    db, 'SELECT sha256, counts_json, feed_start, feed_end FROM gtfs_feed_versions ORDER BY id DESC LIMIT 1');
  if (prev && prev.sha256 === sha256) {
    log.info('gtfs: zip unchanged, skipping reload', { sha256: sha256.slice(0, 12) });
    return { sha256, counts: JSON.parse(prev.counts_json), feedStart: prev.feed_start, feedEnd: prev.feed_end };
  }

  const files = unzipSync(zipBytes);
  const read = (name: string): string => {
    const f = files[name];
    if (!f) throw new Error('gtfs zip missing file: ' + name);
    return strFromU8(f);
  };

  const counts: Record<string, number> = {};
  const validities = new Map<string, Validity>();
  let feedStart: string | null = null;
  let feedEnd: string | null = null;

  db.exec('BEGIN');
  try {
    clearGtfsTables(db);

    { // stops
      const t = table(read('stops.txt'));
      const iId = t.indexOf('stop_id'), iName = t.indexOf('stop_name'), iLat = t.indexOf('stop_lat'), iLon = t.indexOf('stop_lon'), iUrl = t.indexOf('stop_url');
      const stmt = db.prepare('INSERT OR REPLACE INTO gtfs_stops VALUES(?,?,?,?,?)');
      for (const r of t.rows) {
        runStmt(stmt, [
          r[iId!] ?? '',
          r[iName!] ?? null,
          iLat != null ? Number(r[iLat]) : null,
          iLon != null ? Number(r[iLon]) : null,
          iUrl != null ? r[iUrl] : null,
        ]);
      }
      counts.stops = t.rows.length;
    }
    { // routes
      const t = table(read('routes.txt'));
      const iId = t.indexOf('route_id'), iAg = t.indexOf('agency_id'), iSn = t.indexOf('route_short_name'), iLn = t.indexOf('route_long_name'), iTy = t.indexOf('route_type');
      const stmt = db.prepare('INSERT OR REPLACE INTO gtfs_routes VALUES(?,?,?,?,?)');
      for (const r of t.rows) {
        runStmt(stmt, [
          r[iId!] ?? '',
          iAg != null ? r[iAg] : null,
          iSn != null ? r[iSn] : null,
          iLn != null ? r[iLn] : null,
          iTy != null ? Number(r[iTy]) : null,
        ]);
      }
      counts.routes = t.rows.length;
    }
    { // trips
      const t = table(read('trips.txt'));
      const iId = t.indexOf('trip_id'), iRoute = t.indexOf('route_id'), iSvc = t.indexOf('service_id'), iSn = t.indexOf('trip_short_name');
      const stmt = db.prepare('INSERT OR REPLACE INTO gtfs_trips VALUES(?,?,?,?)');
      for (const r of t.rows) {
        const tripId = r[iId!] ?? '';
        const serviceId = r[iSvc!] ?? '';
        runStmt(stmt, [tripId, r[iRoute!] ?? null, serviceId, iSn != null ? r[iSn] : null]);
        const v = parseValidity(serviceId);
        validities.set(tripId, { tripId, from: v.from, to: v.to });
      }
      counts.trips = t.rows.length;
    }
    { // stop_times — keep raw seconds-since-service-midnight
      const t = table(read('stop_times.txt'));
      const iTrip = t.indexOf('trip_id'), iSeq = t.indexOf('stop_sequence'), iStop = t.indexOf('stop_id'), iArr = t.indexOf('arrival_time'), iDep = t.indexOf('departure_time');
      const stmt = db.prepare('INSERT OR REPLACE INTO gtfs_stop_times VALUES(?,?,?,?,?)');
      for (const r of t.rows) {
        runStmt(stmt, [
          r[iTrip!] ?? '',
          Number(r[iSeq!] ?? '0'),
          r[iStop!] ?? '',
          hmsToSec(iArr != null ? r[iArr] : undefined),
          hmsToSec(iDep != null ? r[iDep] : undefined),
        ]);
      }
      counts.stop_times = t.rows.length;
    }
    { // calendar_dates (exception-based; this feed has no calendar.txt)
      const t = table(read('calendar_dates.txt'));
      const iSvc = t.indexOf('service_id'), iDate = t.indexOf('date'), iEx = t.indexOf('exception_type');
      const stmt = db.prepare('INSERT OR REPLACE INTO gtfs_calendar_dates VALUES(?,?,?)');
      for (const r of t.rows) {
        if (iEx != null && r[iEx] !== '1') continue;
        const d = r[iDate!] ?? '';
        const iso = gtfsDateToIso(d);
        if (iso) {
          if (feedStart === null || iso < feedStart) feedStart = iso;
          if (feedEnd === null || iso > feedEnd) feedEnd = iso;
        }
        runStmt(stmt, [r[iSvc!] ?? '', d, iEx != null ? Number(r[iEx]) : 1]);
      }
      counts.calendar_dates = t.rows.length;
    }

    buildTripSummaries(db, validities);

    db.exec('COMMIT');
  } catch (e) {
    db.exec('ROLLBACK');
    throw e;
  }

  runStmt(
    db.prepare('INSERT INTO gtfs_feed_versions(sha256, loaded_at, counts_json, feed_start, feed_end) VALUES(?,?,?,?,?)'),
    [sha256, Date.now(), JSON.stringify(counts), feedStart, feedEnd],
  );
  log.info('gtfs: loaded', { sha256: sha256.slice(0, 12), ...counts, feedStart, feedEnd });
  return { sha256, counts, feedStart, feedEnd };
}
