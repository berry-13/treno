{
  "name": "treno",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Predictive realtime transit intelligence for Italian trains (see GOAL.md)",
  "workspaces": [
    "packages/*"
  ],
  "imports": {
    "#core/*": "./packages/core/src/*",
    "#gtfs/*": "./packages/gtfs/src/*",
    "#providers/*": "./packages/providers/src/*",
    "#storage/*": "./packages/storage/src/*",
    "#collector/*": "./packages/collector/src/*"
  },
  "scripts": {
    "gtfs:load": "tsx packages/gtfs/src/cli.ts",
    "gtfs:atm": "tsx packages/gtfs/src/atm.ts",
    "collector": "tsx packages/collector/src/index.ts",
    "api": "tsx packages/api/src/server.ts",
    "bench": "tsx packages/collector/src/bench.ts",
    "train": "tsx packages/collector/src/train.ts",
    "backtest": "tsx packages/collector/src/backtest.ts",
    "train:connections": "tsx packages/collector/src/train-connections.ts",
    "backfill:monechi": "tsx packages/collector/src/backfill-monechi.ts",
    "backfill:crowding": "tsx packages/collector/src/backfill-crowding.ts",
    "raillocations:backfill": "tsx packages/collector/src/raillocations-backfill.ts",
    "train:platforms": "tsx packages/collector/src/train-platforms.ts",
    "train:sweep": "tsx packages/collector/src/train-sweep.ts",
    "atm:latent-study": "tsx packages/collector/src/atm-latent-study.ts",
    "conflicts:backfill": "tsx packages/collector/src/conflicts-backfill.ts",
    "quality:backfill": "tsx packages/collector/src/quality-backfill.ts",
    "retain": "tsx packages/storage/src/retention.ts",
    "ch:backfill": "tsx packages/storage/src/backfill-ch.ts",
    "export:parquet": "tsx packages/storage/src/export-parquet.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@hono/node-server": "^1.13.0",
    "fflate": "^0.8.2",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
