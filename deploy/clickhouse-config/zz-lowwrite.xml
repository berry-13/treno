<clickhouse>
  <!--
    2026-11-13 fix P7 (ZC1 sweep): the stock image logs at trace level into
    files and system.text_log, and keeps every system log table forever
    (6.8 GiB of self-telemetry vs 0.6 GiB of data, a third of the container's
    NVMe writes). Warning level, short TTLs, and drop the high-volume
    profiling tables nobody reads.
  -->
  <logger>
    <level>warning</level>
    <size>100M</size>
    <count>3</count>
  </logger>
  <text_log>
    <level>warning</level>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
  </text_log>
  <query_log>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
  </query_log>
  <part_log>
    <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
  </part_log>
  <metric_log>
    <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    <collect_interval_milliseconds>10000</collect_interval_milliseconds>
  </metric_log>
  <error_log>
    <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
  </error_log>
  <trace_log remove="1"/>
  <processors_profile_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <query_metric_log remove="1"/>
  <query_thread_log remove="1"/>
  <query_views_log remove="1"/>
  <session_log remove="1"/>
  <opentelemetry_span_log remove="1"/>
</clickhouse>
